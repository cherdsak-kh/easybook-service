// Prisma schema — easy-book-app backend.
//
// The booking domain landed 2026-09-02 (BookingRequest / BookingSlot / AppSetting / BookingStatus,
// at the bottom of this file) — the header previously said it was still to come.
//
// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI/Migrate)
// and is supplied to PrismaClient at runtime via a driver adapter (@prisma/adapter-pg).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Which rich menu a user is assigned (matches the two designs in assets/richmenu).
enum RichMenuType {
  TYPE_1
  TYPE_2
}

/// Whether a user may use the EasyBook app.
/// `UNREGISTERED` is the "zero" state a fresh follower lands on (before submitting the
/// registration form); it is deliberately the first value and the default on LineUser.
/// `REJECTED` (appended 2026-07-25) = "reviewed and sent back — fix the registration and
/// resubmit". Distinct from PENDING (fresh, un-reviewed) and BLOCKED (terminal, punitive).
/// Reachable ONLY via the operator Reject action; carries a mandatory `LineUser.rejectionReason`.
enum AppAccess {
  UNREGISTERED
  PENDING
  ALLOWED
  BLOCKED
  REJECTED
}

/// A LINE user, created when they add the Official Account as a friend.
/// Soft-deleted (deletedAt) on unfollow; restored on re-follow.
model LineUser {
  id            String       @id @default(cuid())
  lineUserId    String       @unique
  displayName   String?
  pictureUrl    String?
  statusMessage String?
  language      String?
  richMenuType  RichMenuType @default(TYPE_1)
  access        AppAccess    @default(UNREGISTERED)

  /// Operator-authored revision reason, set on an admin Reject and pushed to the user on LINE.
  /// INVARIANT: non-null IFF `access === REJECTED`. Cleared to null on EVERY transition to a
  /// non-REJECTED state (approve, block, or a self-edit resubmit → PENDING). Nullable, no default
  /// (null = "no active rejection"). Free text at the DB layer — the 500-char cap is a DTO input
  /// control, not a column constraint. PDPA: may contain the user's PII; NEVER logged.
  rejectionReason String?

  /// Operator-authored reason for a Block, written on an admin Block and shown ONLY in the
  /// back-office. INVARIANT: non-null only while `access === BLOCKED`; cleared to null on EVERY
  /// transition to another state, exactly like `rejectionReason` above.
  ///
  /// ⚠️ IT IS NOT THE MIRROR OF `rejectionReason`, and the difference is deliberate. A rejection
  /// reason is a MESSAGE — it is pushed to the user on LINE, so an empty one would send a blank
  /// message, which is why the service REQUIRES it (400). A block reason is an internal NOTE: the
  /// user never sees it, and requiring it here would also break the one path that must stay
  /// idempotent (an ADMIN re-sending `BLOCKED → BLOCKED` to retry a 502 rich-menu apply). The
  /// registration screen still asks for one — that is a UI rule, stated as such at the point of use.
  ///
  /// PDPA: operator-authored free text ABOUT a user; NEVER logged, same as `rejectionReason`.
  blockReason String?

  followedAt    DateTime     @default(now())

  /// When this user SUBMITTED their registration. NULL until they do — which is what makes the
  /// registration screen show a dash under `วันที่ลงทะเบียน` for a follower who never registered.
  ///
  /// ⚠️ NOT `followedAt`. That is the day they added the OA as a friend; these differ by however
  /// long someone took to fill in the form.
  ///
  /// Why it lives HERE and not just on `LineUserRegistration.createdAt` (which also records it):
  /// the back-office list sorts by this, and rows without a registration must sort LAST in BOTH
  /// directions — "has no date" is not "is the oldest". `NULLS LAST` is expressible in Prisma only
  /// on a nullable SCALAR of the model being ordered, never through a to-one relation (verified
  /// against the generated types). Without this column the DEFAULT ordering — newest first — would
  /// put every unregistered follower ABOVE the pending approval queue, because Postgres sorts NULLs
  /// FIRST on DESC. That is the exact opposite of what a queue is for.
  ///
  /// Written ONCE, in the same transaction that creates the registration and flips access to
  /// PENDING. A self-edit or an admin correction does NOT move it: it is the submission date, not
  /// the last-touched date.
  registeredAt  DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  /// Back-relation for SystemUser.lineUser (DD-5). VIRTUAL — adds no column to line_users.
  /// Presence of a SystemUser here is a notification address, never an identity or a session.
  systemUser SystemUser? @relation("SystemUserLineAccount")

  /// Back-relation for the 1:1 registration a LINE user submits to move UNREGISTERED -> PENDING.
  /// VIRTUAL — adds no column to line_users. Nullable: a follower who never registered has none.
  registration LineUserRegistration? @relation("LineUserToRegistration")

  /// Back-relation for BookingRequest.lineUserId (D-C18). VIRTUAL — adds no column to line_users.
  /// EMPTY for a follower who never booked, and empty forever for the staff-created half of the
  /// booking table: those rows carry `createdById` instead. This is the LIFF origin's list.
  bookingRequests BookingRequest[] @relation("BookingRequesterLineUser")

  @@index([deletedAt])
  /// The list's default ordering key.
  @@index([registeredAt])
  @@map("line_users")
}

/// Personnel identity a LINE end-user submits to move from UNREGISTERED -> PENDING.
/// 1:1 with LineUser. Holds PDPA-governed PII (real name, phone).
model LineUserRegistration {
  id String @id @default(cuid())

  /// FK -> LineUser.id (a cuid), NOT LineUser.lineUserId (the "U…" string). Same-name footgun as
  /// SystemUser.lineUserId — this is the cuid PK, the notification/identity target row. @unique
  /// makes the relation 1:1: one registration per LineUser.
  lineUserId String   @unique
  lineUser   LineUser @relation("LineUserToRegistration", fields: [lineUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  firstName String
  lastName  String

  /// Loosely validated in the DTO (Thai formats), mirroring SystemUser.phoneNumber. Stored as given.
  /// "As given" is right for DISPLAY and useless for SEARCH — see phoneDigits below.
  phone String

  /// `phone` with every non-digit removed, written by the service on every write of `phone` and
  /// never by a client (absent from every DTO, so `forbidNonWhitelisted` 400s any attempt to send
  /// it — the same construction that protects `isSystemReserved`).
  ///
  /// The registration screen searches by phone, and an operator reads a number off a form as
  /// "0812345678" while the row holds "081-234-5678". Matching those means comparing digits to
  /// digits, and `phone` cannot be normalised in place without destroying the formatting the
  /// operator submitted. Derived columns are a cost — two fields that can disagree — and the
  /// alternative was worse: `regexp_replace` inside `$queryRaw`, which puts the most complex query
  /// in the system beyond Prisma's type checking and beyond any index.
  ///
  /// ⚠️ EXTENSIONS ARE TRUNCATED, NOT INCLUDED. "02-123-4567 ต่อ 101" stores `021234567`, not
  /// `021234567101` — otherwise searching "101" would surface every number whose extension happens
  /// to be 101, and an operator searching a phone number does not mean the extension.
  phoneDigits String

  /// FK -> Department.id (an auto-increment Int). Required: every registration picks a department
  /// option (SC-2.4/Q4). `onDelete: Restrict` refuses a stray hard delete of a referenced option —
  /// normal deletes are soft (deletedAt), so a referenced row is never hard-deleted. Resolves for
  /// display even when the option is soft-deleted (the FK row persists; only deletedAt is set).
  departmentId Int
  department   Department @relation("RegistrationDepartment", fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// FK -> PersonnelRole.id (an auto-increment Int; the LINE end-user's self-declared role — NOT
  /// SystemRole). Required.
  personnelRoleId Int
  personnelRole   PersonnelRole @relation("RegistrationPersonnelRole", fields: [personnelRoleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft-delete parity column, reserved for a future right-to-erasure path. THIS feature never
  /// sets it and never cascades it from LineUser unfollow (registration persists across re-follow).
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([departmentId])
  @@index([personnelRoleId])
  /// The registration screen's search box reads these three; `createdAt` is its default sort AND
  /// the `วันที่ลงทะเบียน` column. Added now for one reason only: on an empty table an index costs
  /// nothing, and after the first migration it is a lock on a table people are using. One school's
  /// data does not need them for speed today.
  @@index([phoneDigits])
  @@index([lastName, firstName])
  @@index([createdAt])
  @@map("line_user_registrations")
}

/// Admin-curated department/faculty options for the LINE registration form. Soft-deleted, never
/// hard-deleted. The active-name uniqueness is a PARTIAL unique index (`WHERE deletedAt IS NULL`,
/// authored in raw SQL in the migration — the PSL cannot express it), so `name` is deliberately NOT
/// `@unique` here: a soft-deleted name is REUSABLE (SC-2.3/Q2). Holds no PII.
model Department {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// TRUE only for the row the System Developer (SUPER_ADMIN) owns, created exclusively by
  /// scripts/create-super-admin.ts. A reserved row is INVISIBLE to every non-SUPER_ADMIN option list
  /// and UNASSIGNABLE by any other actor (-> the same 400 as an unknown option id, never a 403).
  ///
  /// This is a FLAG, not a name, and that distinction is load-bearing (see AC-X3): a row NAMED
  /// 'ผู้พัฒนาระบบ (System Developer)' with isSystemReserved=false is an ordinary, visible, assignable
  /// option that grants nothing — exactly like a PersonnelRole named "ADMIN". The flag is the boundary.
  ///
  /// Settable by NO endpoint: it is absent from every DTO, so `forbidNonWhitelisted: true` 400s any
  /// attempt to send it (the same construction that protects SystemUser.lineUserId).
  isSystemReserved Boolean @default(false)

  registrations LineUserRegistration[] @relation("RegistrationDepartment")

  /// Back-relation for SystemUser.department. VIRTUAL — adds no column to departments.
  systemUsers SystemUser[] @relation("SystemUserDepartment")

  /// Back-relation for BookingRequest.departmentId (D-C18). VIRTUAL — adds no column to departments.
  /// ⚠️ This is the department the booking is FOR, typed in by staff on a direct booking. It is NOT
  /// the creating staff member's own department (that is `SystemUser.departmentId`), and it is NOT
  /// how a LIFF request resolves its department — that reads through
  /// `BookingRequest.lineUserId -> LineUserRegistration.departmentId`. Three different questions,
  /// and only this one is a manual override.
  bookingRequests BookingRequest[] @relation("BookingDepartment")

  @@index([deletedAt])
  @@map("departments")
}

/// Admin-curated PERSONNEL role options (Teacher, Support Staff, …) — a JOB TITLE.
///
/// TWO consumers since 2026-07-16: (1) the LINE registration form — the end-user's self-declared
/// role; (2) back-office staff job titles (SystemUser.personnelRoleId, the former free-text
/// `position` column). One curated vocabulary, two readers.
///
/// CRITICAL: `PersonnelRole` is NOT `SystemRole`. `SystemRole` (SUPER_ADMIN | ADMIN | VIEWER, on
/// SystemUser) is the back-office RBAC enum and the only grantor of privilege. They share NO table,
/// enum, type, endpoint, or seed, and never cross a code path. A `SystemUser` now holds BOTH: only
/// `SystemRole` grants privilege, and a `PersonnelRole` named "ADMIN" is a string — an inert label
/// on a VIEWER user who still gets 403 everywhere. Never compare, map, or fall back between them.
/// Soft-deleted, name reusable (partial unique index — same as Department). Holds no PII.
model PersonnelRole {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// TRUE only for the row the System Developer (SUPER_ADMIN) owns — see Department.isSystemReserved
  /// for the full rationale. Invisible to every non-SUPER_ADMIN option list, unassignable by any
  /// other actor (the same 400 as an unknown id, never a 403), settable by no endpoint, and written
  /// exclusively by scripts/create-super-admin.ts.
  ///
  /// A FLAG, not a name: a row NAMED 'ผู้ดูแลระบบระดับสูง (System Administrator)' with
  /// isSystemReserved=false is an ordinary option granting nothing — exactly like the PersonnelRole
  /// named "ADMIN" that AC-X3 pins. Privilege is SystemUser.role and only that.
  isSystemReserved Boolean @default(false)

  registrations LineUserRegistration[] @relation("RegistrationPersonnelRole")

  /// Back-relation for SystemUser.personnelRole. VIRTUAL — adds no column to personnel_roles.
  systemUsers SystemUser[] @relation("SystemUserPersonnelRole")

  @@index([deletedAt])
  @@map("personnel_roles")
}

/// ประเภทสถานที่ — admin-curated venue categories. The THIRD table of this shape (Department,
/// PersonnelRole, and now this), and it is deliberately a table rather than a Prisma enum for the
/// same reason as those two: the school curates the vocabulary, and an enum would need a migration
/// to add a category.
///
/// Soft-deleted, never hard-deleted. Active-name uniqueness is a PARTIAL unique index
/// (`WHERE "deletedAt" IS NULL`, raw SQL in the migration — the PSL cannot express it), so `name` is
/// deliberately NOT `@unique` here: a soft-deleted name is REUSABLE. Holds no PII.
///
/// ⚠️ THE FIVE STARTING CATEGORIES ARE NOT INVENTED. `project-documents/markdown/บทที่ 1.md` §1.3.2
/// lists the nine real venues this system is for, and they project onto exactly five categories
/// (โรงยิม 3 · ลานกิจกรรม 2 · สนามกีฬา 1 · ห้องประชุม 1 · หอประชุม 2 = 9). An earlier, invented
/// taxonomy (ห้องเรียน · ห้องปฏิบัติการ · ห้องคอมพิวเตอร์ · โรงอาหาร) matched NOT ONE of the nine.
/// They are a SEED, not a validation set — `scripts/seed-venue-types.ts` writes them and nothing
/// checks against them afterwards.
model VenueType {
  id   Int    @id @default(autoincrement())
  name String

  /// TRUE only for the tombstone row `ไม่พบประเภทสถานที่`, where a deleted category's venues are
  /// re-pointed. Identical flag and identical meaning to Department.isSystemReserved: it supplies
  /// the lock in the table, the SUPER_ADMIN-only visibility, and the 404 on rename/delete for every
  /// role — all three for free.
  ///
  /// ⚠️ THIS TABLE HAS EXACTLY ONE BEARER, unlike the other two. The personnel tables each carry TWO
  /// reserved rows because `create-super-admin.ts` must file the System Developer under a ตำแหน่ง
  /// and a กลุ่ม/ฝ่าย. It needs no venue category. So here `isSystemReserved` and the derived
  /// `isFallback` are true of the same single row — which is NOT a reason to collapse them: an
  /// operator may create an ordinary row literally NAMED `ไม่พบประเภทสถานที่`, and the flag is what
  /// keeps that row ordinary and assignable.
  ///
  /// Settable by NO endpoint: absent from every DTO, so `forbidNonWhitelisted: true` 400s any
  /// attempt — the same construction that protects `SystemUser.lineUserId`.
  ///
  /// ⚠️ ITS ONE WRITER IS `scripts/seed-venue-types.ts`, not `create-super-admin.ts` and not
  /// `options:seed` (`Q16`, answered 2026-08-25). The rule those two encode is "exactly ONE writer
  /// of this flag PER TABLE"; this table had none, so its seed script becomes that writer and may
  /// therefore write both the ordinary rows and the reserved one.
  isSystemReserved Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Back-relation for `Venue.venueType`. ✅ UNCOMMENTED 2026-08-25 with VENUE-1 — the moment the
  /// comment that stood here named for itself. `VenueTypeResponseDto.holderCount` stopped being a
  /// hard zero in the same commit and became a real `_count` over this relation.
  venues Venue[] @relation("VenueVenueType")

  @@index([deletedAt])
  @@map("venue_types")
}

/// อุปกรณ์ที่ให้บริการ — admin-curated amenity vocabulary, ticked on the venue form and used to
/// filter venues. Soft-deleted; partial unique index on the active name, exactly like the three
/// tables above. Holds no PII.
///
/// ⚠️ NO `isSystemReserved`, AND THE ABSENCE IS THE DESIGN — not an oversight and not "add it later
/// if needed". Neither kind of reserved row can exist here:
///
///   · no System Developer row — that account needs a ตำแหน่ง and a กลุ่ม/ฝ่าย, never an amenity;
///   · no tombstone — an amenity is a TICK in a join table, so deleting one removes ticks and
///     orphans nothing. There is no required FK left dangling, hence nowhere to re-point to.
///
/// The rejected alternative was to add the column `@default(false)` so all four tables look alike.
/// A column that no code may ever write `true` is a lie that does not sit still — somebody finds a
/// use for it. And the uniformity it buys is imaginary: `OptionDelegate` hard-codes three things
/// this table contradicts (the `_count` is over a different table, the delete resolves no tombstone,
/// and holders are แห่ง rather than คน), so this table needs its own service either way.
///
/// The WIRE shape stays identical — `AmenityResponseDto` returns `isSystemReserved: false` and
/// `isFallback: false` as constants — because what the client shares with the other three screens is
/// a response shape, not a column.
///
/// ⇒ This is the only one of the four curated tables where a SUPER_ADMIN and an ADMIN see
/// byte-identical rows, and the only one that may legitimately ship EMPTY: the other three are
/// pointed at by required FKs, so an empty table means nothing can be created at all, while an
/// amenity is optional on the venue form. `Q18` (2026-08-25): the vocabulary is the operator's, so
/// there is no correct starting list to collect — only one to avoid inventing. **It seeds zero rows.**
model Amenity {
  id   Int    @id @default(autoincrement())
  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Back-relation for `VenueAmenity.amenity`. ✅ UNCOMMENTED 2026-08-25 with VENUE-1, alongside
  /// `VenueType.venues`. `DELETE /amenities/:id` now really does release ticks, and
  /// `releasedVenueCount` is their count rather than the honest 0 it used to be.
  venues VenueAmenity[]

  @@index([deletedAt])
  @@map("amenities")
}

/// สถานที่จัดกิจกรรม — a bookable place. The "Resource" the header of this file has been promising
/// since the init migration, and the product's actual subject: every other table in this schema is
/// paperwork arranged around this one.
///
/// Soft-deleted, never hard-deleted. The delete confirmation promises
/// "ประวัติคำขอจองของสถานที่นี้ยังอยู่ครบ", and a future `Booking.venueId` must keep resolving a name
/// long after an operator retires the room.
///
/// ⚠️ FIELD SET ARGUED FROM DECISIONS, NOT COPIED FROM HOTEL SOFTWARE. Every column here is consumed
/// by one of three deciders (`[data-route="venues"]` in the prototype states them): the LINE user
/// picking a place, the admin approving a request, the admin maintaining the list. Deliberately
/// ABSENT, each for a stated reason: ราคา (no evidence this school charges), คะแนนรีวิว (no actor
/// writes it), รหัสสถานที่ (nine unique names have no collision to solve), พิกัด GPS, ขนาด ตร.ม.
/// (answers what `capacity` already answers, in a unit nobody measured), and opening hours (`Q17d`:
/// the PO said เวลา is not decided, so no column may guess).
model Venue {
  /// cuid, not autoincrement — the rule this schema now follows. Curated VOCABULARY tables are Int
  /// (`Department`, `PersonnelRole`, `VenueType`, `Amenity`: small, seeded, referenced by id in a
  /// query string a human reads); ENTITIES are cuid (`LineUser`, `SystemUser`,
  /// `LineUserRegistration`, and this). A venue is an entity — it has photos, a description, its own
  /// open/closed lifecycle, and `Booking` will carry its id.
  id String @id @default(cuid())

  /// Required. Unique among ACTIVE rows via a partial unique index (`venues_name_active_key`,
  /// hand-written in the migration — PSL cannot express `WHERE "deletedAt" IS NULL`), so a
  /// soft-deleted name is reusable exactly like an option name. 120 chars is a DTO cap
  /// (`maxlength="120"` on `#vf-name`), not a column constraint.
  name String

  /// FK -> VenueType.id. REQUIRED — every venue has exactly one category (`Q15a`), so the form
  /// offers no blank option: "ไม่ระบุ" is not a value the server can store.
  ///
  /// `onDelete: Restrict` refuses a stray HARD delete of a referenced category. Normal category
  /// deletes are SOFT, and a soft-deleted row is still a live FK target, so the FK does not do this
  /// job — `VenueTypesService.softDelete` re-points these rows onto the tombstone inside the same
  /// transaction. Same read/write asymmetry as `SystemUser.departmentId`: READS ignore `deletedAt`
  /// (an existing venue keeps resolving its category name forever), WRITES require an ACTIVE,
  /// NON-RESERVED category -> 400.
  venueTypeId Int
  venueType   VenueType @relation("VenueVenueType", fields: [venueTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Required. `min="1" max="100000"` on the form; both are DTO bounds. `min` is 1 and not 0 — a
  /// venue that holds nobody is not a venue, and 0 is what a half-filled form submits by accident.
  capacity Int

  /// ที่ตั้ง — optional, and it EARNED its place on evidence rather than on inference: four of the
  /// nine real venues carry their location INSIDE the name, in parentheses (`ลานกิจกรรม
  /// (ข้างพระนเรศวร)`). Nobody writes a parenthetical into a proper name for fun; they do it when the
  /// form has nowhere else to put it.
  location String?

  /// รายละเอียด — optional free text: conditions of use, what to bring, what to watch out for.
  description String?

  /// เปิดให้จอง. FALSE = ปิดชั่วคราว — the venue stays VISIBLE to end users but accepts no NEW
  /// booking requests. NOT a soft delete and not `deletedAt`: an operator reaching for ลบ almost
  /// always means this, which is why the delete dialog names it as the alternative.
  ///
  /// ⚠️ NOT SETTABLE THROUGH `PATCH`. Closing requires a reason and reopening clears it, so it is a
  /// TRANSITION with its own two endpoints (`POST /venues/:id/close` · `/reopen`), never a field in a
  /// diff somebody skimmed. Absent from `UpdateVenueDto` ⇒ `forbidNonWhitelisted` 400s an attempt.
  isOpen Boolean @default(true)

  /// เหตุผลที่ปิด. INVARIANT: non-null IFF `isOpen === false`. Cleared to null on every reopen — the
  /// confirm dialog states that as a promise ("เหตุผลที่ปิดไว้จะถูกล้างทิ้ง").
  ///
  /// ⚠️ IT IS A MESSAGE, NOT A NOTE, and that is what decides the service REQUIRES it. `LineUser`
  /// carries one of each and they behave differently on purpose: `rejectionReason` is pushed to the
  /// user, so an empty one would send a blank message and the service 400s without it; `blockReason`
  /// is an internal note and stays optional so the idempotent re-block path survives. This one is
  /// read by the people it affects — it prints on the venue card and, once LIFF exists, in front of
  /// everybody who tries to book the room. So it follows `rejectionReason`: REQUIRED on the close
  /// transition (400 without it).
  closedReason String?

  photos    VenuePhoto[]
  amenities VenueAmenity[]

  /// Back-relations for the booking domain (D-C13). VIRTUAL — add no column to venues.
  ///
  /// TWO of them, and the pair is deliberate: `bookingSlots` is NOT reachable only through
  /// `bookingRequests`. `BookingSlot.venueId` is denormalised precisely so the overlap query — the
  /// hottest read in the product, run inside the approval transaction — touches one table and one
  /// index. Going through the parent would make it a join.
  bookingRequests BookingRequest[] @relation("BookingVenue")
  bookingSlots    BookingSlot[]    @relation("BookingSlotVenue")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([venueTypeId])
  /// The list filters by status and sorts/searches by name. Free on an empty table, a lock on a
  /// populated one — same reasoning as the registration and staff indexes above.
  @@index([isOpen])
  @@index([name])
  @@map("venues")
}

/// One photo of one venue. A ROW, not an array column, because the ORDER is data the operator edits.
///
/// 🔴 `venues/` IS A SECOND PII STORE AND IS IN `AUTH-ERASURE`'s SCOPE, and the reason is a PATH
/// rather than caution. `avatars/<userId>/…` carries the person's id in the key, so one erasure
/// request is one prefix delete. `venues/<venueId>/…` does NOT — a face in this bucket appears
/// nowhere in the path, so no erasure request can ever locate it. That is what makes the form's
/// "ไม่ควรมีบุคคลอยู่ในภาพ" line a real control and not politeness: it is the last point at which the
/// problem is still preventable. (`Q19`, PO 2026-08-25. The remaining question — school photos
/// contain MINORS — is for the school's PDPA owner before go-live, and blocks no code.)
model VenuePhoto {
  id String @id @default(cuid())

  /// `onDelete: Cascade` — a photo is a PART of its venue with no independent identity, the same
  /// relationship `LineUserRegistration` has to `LineUser`. (Contrast `VenueAmenity.amenityId` below,
  /// which is `Restrict`: an amenity has a life of its own.)
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// https URL of the stored object. The backend NEVER fetches it — same contract as
  /// `SystemUser.profilePictureUrl`.
  url String

  /// 0-based. ⚠️ `position === 0` IS THE COVER — there is no `isCover` flag, deliberately. The dialog
  /// tracks the cover as an INDEX so the thumbnail strip never moves under the cursor, and rotates it
  /// to the front on save; the record keeps `photos[0] === cover`, which is what the card reads and
  /// what this table stores. A flag would be a second record of one fact, free to disagree with the
  /// order — the exact bug `Venue.venueTypeId` exists to avoid.
  ///
  /// NO unique constraint on `[venueId, position]`: the only write pattern is "replace the whole
  /// ordered set", and a non-deferrable unique index would reject the single renumbering statement
  /// that write is made of. Contiguity is the writer's job; the read is
  /// `orderBy: [{ position: 'asc' }, { id: 'asc' }]`, so a duplicate degrades to a stable but
  /// arbitrary order, never to an error.
  position Int

  createdAt DateTime @default(now())

  @@index([venueId, position])
  @@map("venue_photos")
}

/// A TICK: "this venue provides this amenity". The first pure join table in this schema, and the one
/// structural reason `Amenity` needs no tombstone — deleting an amenity removes rows from HERE and
/// orphans nothing, where deleting a `VenueType` would leave a required FK dangling.
model VenueAmenity {
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// `onDelete: Restrict`, NOT Cascade — matching `Department`/`PersonnelRole`. An amenity delete is
  /// a SOFT delete plus an explicit `deleteMany` of these rows inside one transaction, so the cascade
  /// would never fire in normal operation; leaving it as Cascade would only mean a stray HARD delete
  /// silently strips ticks off venues instead of being refused.
  amenityId Int
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@id([venueId, amenityId])
  @@index([amenityId])
  @@map("venue_amenities")
}

/// Back-office operator role. Distinct from AppAccess (LINE consumer domain) by design.
///
/// The third value is VIEWER, not STAFF. "เจ้าหน้าที่" is what the portal calls every operator in
/// it — all three roles — so naming one of the three STAFF made the least privileged role sound
/// like the category containing the other two. VIEWER says what the role can actually do: read.
/// Renamed 2026-08-16, before the first migration, while the value was still free to change.
enum SystemRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

/// A back-office operator. NOT a LINE end-customer — see LineUser.
///
/// Two INDEPENDENT lifecycle flags, never conflated (DD-4):
///   isActive = false  -> temporary, reversible suspension. The user still exists.
///   deletedAt != null -> soft deletion. The row is retained ONLY so the createdById audit
///                        chain stays resolvable. Invisible to every API route.
/// Both must be checked by SessionGuard and by login. See 02_design_log.md §1.1.
model SystemUser {
  id String @id @default(cuid())

  /// Always stored lowercase + trimmed. Normalised in the DTO transform AND in the service.
  /// Plain @unique spans soft-deleted rows: a deleted user's email is permanently burned (DD-6).
  email String @unique

  /// argon2id digest ("$argon2id$..."). Never selected into any DTO.
  passwordHash String

  firstName String
  lastName  String
  role      SystemRole @default(VIEWER)

  /// Forced-reset flag. TRUE from the moment a temp password is issued (POST /system-users,
  /// POST /system-users/:id/reset-password); cleared ONLY by a successful POST /auth/system/password.
  /// camelCase, no @map — live columns in this schema are camelCase.
  ///
  /// ORTHOGONAL to isActive and deletedAt (a third independent flag, not a fourth lifecycle state):
  /// isActive=false is a suspension, deletedAt is soft deletion, and BOTH are 401s at SessionGuard —
  /// they fire FIRST, so a suspended or deleted user never reaches the reset screen. This flag is a
  /// CREDENTIAL state: the user is fully valid, they just may not do anything but change it (403).
  /// Enforced server-side in SessionGuard; a frontend redirect is UX, never the control.
  mustChangePassword Boolean @default(true)

  /// FK -> Department.id. Required: every staff member belongs to exactly one department option.
  /// Replaces the former free-text `department` column (DD-7 superseded by the PO, 2026-07-16 —
  /// see claude_planning/20260716_1342_staff_management/02_design_log.md §0). The values are still
  /// admin-curated DATA, never a Prisma enum, which is what DD-7 actually protected.
  ///
  /// `onDelete: Restrict` refuses a stray HARD delete of a referenced option. Normal option deletes
  /// are SOFT (deletedAt), so this rarely fires — and a soft-deleted option is still a live FK
  /// target, which is deliberate: READS ignore `deletedAt` (an existing assignment keeps resolving
  /// its name forever), WRITES require an ACTIVE option (checked in the service -> 400).
  departmentId Int
  department   Department @relation("SystemUserDepartment", fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// FK -> PersonnelRole.id — the staff member's JOB TITLE ("Teacher", "Director"). The former
  /// free-text `position` column; "position" is the UI label, `personnelRole` is the model.
  ///
  /// CRITICAL: this is NOT `role` above. `role` is SystemRole (SUPER_ADMIN | ADMIN | VIEWER) — the
  /// back-office RBAC enum and the ONLY thing that grants privilege. `personnelRole` is an
  /// admin-curated label that grants ZERO privilege, and a PersonnelRole named "ADMIN" is just a
  /// string. A SystemUser holds BOTH. They are never interchangeable, never compared, and never
  /// cross a code path. Any future `if (user.personnelRole.name === 'ADMIN')` is a privilege-
  /// escalation bug — the guard test in test/ exists to catch exactly that.
  personnelRoleId Int
  personnelRole   PersonnelRole @relation("SystemUserPersonnelRole", fields: [personnelRoleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Display only. Loosely validated (Thai formats + office extensions).
  phoneNumber       String?
  /// https URL only. Rendered by the client; the backend NEVER fetches it. Written server-side by
  /// POST /auth/system/me/avatar (an R2 object URL); also settable to any https URL by an admin.
  profilePictureUrl String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Soft delete (DD-4). NEVER exposed in any DTO. Set ONLY by DELETE /system-users/:id,
  /// cleared ONLY by POST /system-users/:id/restore. Filter `deletedAt: null` when resolving
  /// a user as an IDENTITY; never filter it when resolving createdById as HISTORY.
  deletedAt DateTime?

  /// Audit: which SUPER_ADMIN created this row. Null for the seeded first SUPER_ADMIN.
  /// Resolve WITHOUT a deletedAt filter — a deleted creator must still resolve (DD-4).
  createdById  String?
  createdBy    SystemUser?  @relation("SystemUserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers SystemUser[] @relation("SystemUserCreatedBy")

  /// Optional 1-to-1 link to a personal LINE account, for future admin notifications (DD-5).
  /// FK -> LineUser.id (a cuid). NOT LineUser.lineUserId (the LINE-side "U..." identifier).
  /// Nullable + @unique => at most one SystemUser per LineUser; many SystemUsers may have none.
  /// NOT settable by ANY endpoint in this feature — absent from CreateSystemUserDto and
  /// UpdateSystemUserDto alike, so forbidNonWhitelisted 400s any attempt. Grants no authentication.
  lineUserId String?   @unique
  lineUser   LineUser? @relation("SystemUserLineAccount", fields: [lineUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Back-relations for the booking domain (D-C18). VIRTUAL — add no column to system_users.
  ///
  /// TWO relations to ONE model, which is why both ends must be named: `createdBookings` is the
  /// ADMIN ORIGIN (this person typed the booking in from the back office), `approvedBookings` is the
  /// APPROVAL AUDIT (this person ruled on it). On a direct booking they are the SAME person and both
  /// point here — that is not duplication, it is the record that creation WAS the approval.
  ///
  /// Both are HISTORY, not identity: resolve them WITHOUT a `deletedAt` filter, exactly like
  /// `createdById` above (DD-4). A staff member who has left must still resolve as the creator and
  /// approver of the bookings they made.
  createdBookings  BookingRequest[] @relation("BookingCreatedBy")
  approvedBookings BookingRequest[] @relation("BookingApprovedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([departmentId])
  @@index([personnelRoleId])
  /// The staff screen filters by role and by status, and status is derived from `isActive` and
  /// `mustChangePassword` rather than stored (STAFF-QUERY-1). `email` already has @unique, which
  /// is an index, so the search half needs only the name. Same reasoning as the registration
  /// indexes above: free on an empty table, a lock on a populated one.
  @@index([role])
  @@index([isActive])
  @@index([lastName, firstName])
  @@map("system_users")
}

/// Lifecycle of a BookingRequest (D-C13, PO 2026-08-26).
///
/// ⚠️ THERE IS DELIBERATELY NO `EXPIRED`, and adding one is a schema regression. A pending request
/// nobody ruled on before its time passed is COMPUTED at read time (`lastEndAt < now()`), never
/// stored — the same reasoning that keeps the request's status derived from its slots and keeps
/// `VenuePhoto` free of an `isCover` flag: one fact, one home. A stored EXPIRED needs a cron, and a
/// cron that misses a day makes every screen lie. Filter the approval queue with `lastEndAt > now()`
/// instead. See SERVICE_CHANGES.md §2.4.
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A request to use a venue — the PARENT of one or more BookingSlot rows (D-C13).
///
/// 🔴 DUAL-ORIGIN, AND THAT IS THE WHOLE POINT OF THIS MODEL'S SHAPE (D-C18, PO 2026-09-02).
/// Bookings enter the system two ways, and BOTH live in this one table:
///
///   1. CLIENT PORTAL (LIFF) — a LINE end-user submits a request. `lineUserId` is set,
///      `createdById` is null, and the row ALWAYS starts PENDING. It is a request, never an
///      instant reservation.
///   2. ADMIN PORTAL (back office) — a staff member creates a booking directly: locking a slot for
///      an internal school event, or booking on behalf of a teacher or department that has no LINE
///      account at all. `createdById` is set, and the row MAY be created APPROVED outright with
///      `approvedById = createdById` and `approvedAt = now()`.
///
/// Splitting these into two tables would give the question "is this slot taken?" TWO answers and
/// two code paths to keep in agreement. The origin is expressed in WHICH IDENTITY COLUMN IS
/// POPULATED, not in which model the row lives in.
///
/// ⚠️ D-C13 rule 1 ("a booking requires approval") scopes to the CLIENT origin — it describes what
/// an end-user may initiate. Rules 2-6 bind BOTH origins without exception: parent-child slots,
/// overlap validated at SLOT level, a PENDING request holds nothing, approval auto-rejects every
/// overlapping request, and the client portal is real-time throughout. A staff-created APPROVED
/// booking holds its slot exactly as an approved LIFF request does, and must auto-reject overlapping
/// pending requests in the SAME transaction that creates it.
///
/// 🔴 PRIVACY (D-C13, last clause): an unapproved request NEVER reveals who made it or what for —
/// on screen, on the socket, or in a LINE notification. That rule is about the VIEWER, not about who
/// wrote the row, so it covers staff-created bookings identically.
model BookingRequest {
  id String @id @default(cuid())

  /// Human-readable identifier ("BR-25690902-001") — the string a user pastes out of LINE chat into
  /// the My Bookings search box, and the one staff quote on the phone. SEPARATE from `id` on purpose:
  /// a cuid is unreadable and unspeakable, and a readable PK invites people to parse meaning out of
  /// it. This is a LABEL; `id` is the key. @unique, because the search resolves it directly.
  ///
  /// ⚠️ The client strips a leading "#" before comparing — users paste "#BR-25690902-001".
  code String @unique

  /// FK -> LineUser.id (a cuid), NOT LineUser.lineUserId (the "U..." string). Same-name footgun as
  /// SystemUser.lineUserId and LineUserRegistration.lineUserId.
  ///
  /// 🔴 NULLABLE, AND IT MUST STAY NULLABLE (D-C18). A required column here makes the entire admin
  /// direct-booking half of the product unrepresentable — that need does not disappear, it just
  /// relocates into a second table and a second answer to "is this slot taken?".
  ///
  /// `onDelete: SetNull` — a LINE user who unfollows is SOFT-deleted, so this rarely fires; if a hard
  /// delete ever happens the booking survives as history rather than vanishing from the venue's
  /// schedule. Resolve as HISTORY (no `deletedAt` filter), same asymmetry as `createdById`.
  lineUserId String?
  lineUser   LineUser? @relation("BookingRequesterLineUser", fields: [lineUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// FK -> SystemUser.id. The staff member who created this booking from the Admin Portal — the
  /// ADMIN ORIGIN's identity column. Null on every LIFF request.
  ///
  /// ⚠️ NOT an approval. `approvedById` below records who RULED; this records who TYPED. They are the
  /// same person on a direct booking and different people on an approved LIFF request, and conflating
  /// them loses the distinction between "staff booked this" and "staff allowed this".
  ///
  /// 🔴 DB-LEVEL INVARIANT, hand-written in the migration as `booking_requests_owner_check`:
  /// at least one of `lineUserId` / `createdById` is non-null. A row with neither belongs to nobody —
  /// it cannot be listed on #/bookings, cannot be notified, and cannot be audited. It lives in the
  /// DATABASE and not in a service method because ADR-001's reasoning applies unchanged: a guard one
  /// code path can forget to call is not an invariant.
  ///
  /// ⚠️ BOTH may be set at once, deliberately. That is staff booking ON BEHALF OF a LINE user who
  /// does have an account: `createdById` is who typed it, `lineUserId` is whose booking it is, and
  /// the row correctly appears in that user's My Bookings list.
  createdById String?
  createdBy   SystemUser? @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Manual overrides for a staff entry: who the booking is FOR, when there is no LineUser row to
  /// read a name and phone from.
  ///
  /// 🔴 OVERRIDES, NOT A SECOND PROFILE STORE. On a LIFF request these stay NULL and the name, phone
  /// and department are read through `lineUserId` -> LineUserRegistration. Copying them onto every
  /// row would be one fact in two places, free to disagree the moment a user corrects their
  /// registration — the exact bug VenuePhoto's absent `isCover` flag exists to avoid.
  ///
  /// PDPA: `requesterName` and `contactPhone` are PII. NEVER logged.
  requesterName String?
  contactPhone  String?

  /// FK -> Department.id. Manual override, same rule as the two fields above.
  /// ⚠️ The department the booking is FOR — not the creating staff member's own department, and not
  /// how a LIFF request resolves its department. `onDelete: SetNull` rather than Restrict: this is
  /// an optional label on a historical record, not a required classification like
  /// `SystemUser.departmentId`. Reads ignore `deletedAt` (an existing booking keeps resolving its
  /// department name forever); writes require an ACTIVE option, checked in the service -> 400.
  departmentId Int?
  department   Department? @relation("BookingDepartment", fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// FK -> Venue.id. REQUIRED — a booking with no venue is not a booking.
  /// `onDelete: Restrict`: venue deletes are SOFT, and a soft-deleted venue is still a live FK
  /// target, so this only refuses a stray HARD delete of a venue that has history.
  venueId String
  venue   Venue  @relation("BookingVenue", fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// วัตถุประสงค์ and จำนวนผู้เข้าร่วม — BOTH MANDATORY (D-C13). They are not description fields:
  /// because a PENDING request holds nothing and several may overlap, a human has to CHOOSE between
  /// competing requests, and that choice cannot be made from times alone.
  ///
  /// 🔴 `purpose` is never shown for an UNAPPROVED request belonging to somebody else (D-C13).
  purpose   String
  attendees Int

  status BookingStatus @default(PENDING)

  /// Why it was refused. Written on BOTH refusal paths — an operator's explicit reject, AND the
  /// AUTO-REJECTION that fires when a competing request wins the slot (D-C13 rule 5). The second is
  /// the common one and the reason this column is not optional in practice.
  /// ⚠️ An auto-rejection may say the slot went to someone else; it must NEVER say who, or what for.
  rejectReason String?

  /// DENORMALISED span across this request's slots: earliest start, latest end.
  ///
  /// 🔴 NOT a convenience — a REQUIREMENT of this repo's own pagination rule. Cursor pagination here
  /// must order on a scalar belonging to the model being ordered, never through a relation (the same
  /// constraint that produced `LineUser.registeredAt`). My Bookings sorts by "soonest" and the
  /// approval queue filters by "not yet past", and both of those are aggregates over booking_slots.
  /// Ordering through the child collection is not expressible; these two columns make it a plain
  /// indexed scalar sort.
  ///
  /// ⚠️ WRITER'S CONTRACT: recompute BOTH in the SAME transaction as any write that adds, removes or
  /// cancels a slot. They are a cache of the children, and a stale cache here silently mis-sorts the
  /// list and mis-filters the queue rather than erroring.
  ///
  /// `lastEndAt` is also what makes the computed "expired" state possible without an enum value or a
  /// cron: `status = PENDING AND lastEndAt < now()`.
  firstStartAt DateTime
  lastEndAt    DateTime

  /// Approval audit. FK -> SystemUser.id; resolve as HISTORY, never filtered by `deletedAt` (DD-4).
  /// On an admin DIRECT booking these are written in the creating transaction with
  /// `approvedById = createdById` and `approvedAt = now()` — creation IS the approval (D-C18).
  approvedById String?
  approvedBy   SystemUser? @relation("BookingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt   DateTime?

  /// The children. "Continuous single span" and "repeat across several days" differ ONLY in how many
  /// rows land here (D-C13 rule 2) — they are not two kinds of request and must never become two
  /// code paths.
  slots BookingSlot[] @relation("BookingSlotRequest")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lineUserId])
  @@index([createdById])
  @@index([venueId])
  @@index([status])
  /// The approval queue ("pending, not yet past") and My Bookings' "soonest" sort both read this
  /// pair. Free on an empty table, a lock on a populated one — same reasoning as every other index
  /// in this schema.
  @@index([firstStartAt, lastEndAt])
  @@map("booking_requests")
}

/// ONE occupied time span at ONE venue — the CHILD of a BookingRequest, and the row that actually
/// holds a slot (D-C13, Q-C4).
///
/// 🔴 THIS IS WHERE THE TRUTH LIVES. A request's effective status is DERIVED from its slots; it is
/// not a second stored column free to disagree with them (Q-C4 sub-ruling 2). Overlap is validated
/// HERE, cancellation happens HERE, and a request whose every slot is cancelled becomes CANCELLED by
/// computation.
model BookingSlot {
  id String @id @default(cuid())

  /// `onDelete: Cascade` — a slot is a PART of its request with no independent identity, the same
  /// relationship VenuePhoto has to Venue and LineUserRegistration has to LineUser.
  bookingRequestId String
  bookingRequest   BookingRequest @relation("BookingSlotRequest", fields: [bookingRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// DENORMALISED from the parent, deliberately.
  ///
  /// 🔴 The overlap check is the hottest read in the product and runs INSIDE the approval
  /// transaction, where it is also the correctness boundary (ADR-001: double-booking is prevented by
  /// database constraints inside a transaction, never by an application check alone). Carrying
  /// `venueId` here makes that query one table and one index — `@@index([venueId, startAt, endAt])`
  /// below — instead of a join back through the parent on every approval.
  ///
  /// ⚠️ WRITER'S CONTRACT: it MUST equal `bookingRequest.venueId`. Nothing in the schema can enforce
  /// that, so slots are only ever written by the service that creates the parent, in the same
  /// transaction, from the same value. A request never changes venue — an approver who wants a
  /// different room rejects and asks for a new request, which is also what keeps the audit honest.
  venueId String
  venue   Venue  @relation("BookingSlotVenue", fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The occupied span. Half-open [startAt, endAt): a slot ending 12:00 and one starting 12:00 do
  /// NOT overlap. State it here because the overlap predicate is written in several places and one
  /// of them using closed intervals produces phantom conflicts nobody can reproduce.
  ///
  /// 🔴 "No booking in the past" is checked against EACH SLOT's `startAt` versus the real clock —
  /// NOW, never TODAY (D-C16). Today is still bookable at 09:00 for 14:00.
  startAt DateTime
  endAt   DateTime

  /// Cancellation, per slot (Q-C4 sub-ruling 2). A three-slot request whose Monday has already begun
  /// can still have its Tuesday and Wednesday cancelled.
  ///
  /// ⚠️ `isCancelled` is a FLAG, `cancelledAt` is a TIMESTAMP, and keeping both is a deliberate
  /// exception to this schema's usual "the timestamp IS the flag" pattern (`deletedAt`). The reason
  /// is the index: the overlap query must exclude cancelled slots on EVERY read, and a boolean
  /// column indexes and reads more cheaply than `cancelledAt IS NULL` in a composite predicate.
  /// 🔴 WRITER'S CONTRACT: they are written TOGETHER, always. `isCancelled = true` with a null
  /// `cancelledAt` is a corrupt row.
  ///
  /// 🔴 A CANCELLED SLOT FREES IMMEDIATELY, and requests previously auto-rejected for that slot are
  /// NOT revived (Q-C4) — the user may well have made other plans. They are TOLD it is free again.
  isCancelled Boolean   @default(false)
  cancelledAt DateTime?

  /// Who cancelled, as an UNCONSTRAINED pair rather than two nullable FKs.
  ///
  /// 🔴 THE ACTOR MAY BE EITHER DOMAIN, and this schema has no bridge between them: a LineUser and
  /// a SystemUser share no table, no session and no authentication surface. Two nullable FKs plus an
  /// "exactly one is set" rule would be a third invariant to police for an AUDIT field that no query
  /// joins on. `cancelledByRole` says which table `cancelledById` points into, and the service writes
  /// both.
  ///
  /// ⚠️ THE LIVE VALUE SET IS "LINE_USER" | "SUPER_ADMIN" | "ADMIN" (G3, 2026-09-04). It used to read
  /// "STAFF" here, which no longer exists: `SystemRole`'s third slot is `VIEWER`, and a VIEWER cannot
  /// cancel anything — every staff write route is `@Roles(SUPER_ADMIN, ADMIN)`. The staff paths write
  /// the actor's REAL `SystemRole`, so "STAFF" can never be produced by any code path in this repo.
  /// ⚠️ It is therefore NOT a foreign key and resolves nothing on its own. Do not `include` it.
  cancelledById   String?
  cancelledByRole String?

  /// Optional free text. PDPA: may name a person or a reason; never logged.
  cancelReason String?

  /// 🔴 NOT DATA — AN INDEX KEY, AND THE DATABASE IS ITS ONLY WRITER.
  ///
  /// It mirrors exactly one derived fact: `(NOT isCancelled) AND bookingRequest.status = APPROVED`
  /// — "this row is currently occupying the calendar". It exists because the double-booking rule is
  /// enforced by a partial GiST exclusion constraint (`booking_slots_no_overlap`), a partial index
  /// predicate may only read columns OF THE SAME ROW, and the parent's status is in another table.
  /// A generated column cannot reach it either (same-row restriction), which is why this is a
  /// trigger-maintained column and not `GENERATED ALWAYS AS`.
  ///
  /// 🔴 THIS IS NOT THE `status` COLUMN `Q-C4` sub-ruling 2 FORBIDS, and the difference is that this
  /// one is not FREE TO DISAGREE:
  ///   1. `booking_slots_holds_slot_biu` is a BEFORE INSERT OR UPDATE trigger that OVERWRITES `NEW`
  ///      unconditionally — a value written by Prisma, psql or Studio is recomputed and discarded.
  ///   2. `booking_requests_holds_slot_au` refreshes every child the moment the parent's status
  ///      changes, in that same transaction.
  ///   3. NOTHING IN `src/` READS IT. The application's overlap predicate still asks
  ///      `bookingRequest.status = APPROVED AND isCancelled = false` (`booking-overlap.ts`), which is
  ///      the single owner AC-BR19 requires. A request's status remains DERIVED from its slots.
  ///
  /// ⚠️ NEVER add it to a DTO, a `select`, or a `where`. It is not a fact about the domain; it is the
  /// materialised predicate an index cannot compute for itself. If you find yourself reading it, the
  /// thing you actually want is `booking-overlap.ts`.
  holdsSlot Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 🔴 THE OVERLAP INDEX. Every availability read and every approval transaction uses it.
  @@index([venueId, startAt, endAt])
  @@index([bookingRequestId])
  @@index([isCancelled])
  @@map("booking_slots")
}

/// A single system setting, as a key-value row (Q-C4 sub-ruling 1).
///
/// This is the FIRST real settings store in the schema. The four tables the admin portal calls
/// "system settings" — VenueType, Amenity, Department, PersonnelRole — are OPTION LISTS: curated
/// vocabularies a user picks from. This is a knob an operator turns.
///
/// Seeded in the migration with `booking.cancel_lead_minutes = 30` so the backend has a value from
/// the moment the table exists and needs no rework when the admin screen to edit it arrives
/// (CLIENT-SETTINGS-1, undesigned).
///
/// 🔴 THE LEAD TIME IS ENFORCED ON THE SERVER, ALWAYS. The client reads it to enable a button and to
/// write an explanation. A disabled button is UX, not an authorisation boundary — a late cancellation
/// must be REFUSED by the server (Q-C4).
///
/// ⚠️ `value` is TEXT for every setting, parsed at the point of use. A key-value table with a typed
/// column per setting is a schema migration per knob; this is not. The cost is that a bad value is a
/// runtime problem, so every read parses with a fallback to the documented default rather than
/// throwing — a malformed row must not take the cancel endpoint down.
model AppSetting {
  /// The setting's name, dotted ("booking.cancel_lead_minutes"). It IS the primary key: settings are
  /// looked up by name and by nothing else, so a surrogate id would be a second identifier for the
  /// same row with no reader.
  key String @id

  value String

  /// What this knob does, for whoever meets it in Prisma Studio before the admin screen exists.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
